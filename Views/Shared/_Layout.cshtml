@* VentasApp/Views/Shared/_Layout.cshtml *@
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    // Obtener datos de la sesión de forma segura
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    bool isAdmin = userRole?.Equals("Admin", StringComparison.OrdinalIgnoreCase) ?? false; // Cambiado a 'Admin' según SP
    bool isLoggedIn = userId.HasValue && userId.Value > 0;
    string appName = "Sistema Ventas"; // Nombre de la aplicación
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VentasApp.styles.css" asp-append-version="true" />
    @* Opcional: Añadir referencia a iconos si los usas *@
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"> *@
    @* Renderizar estilos específicos de cada vista si existen *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @* Enlace principal: Si está logueado, va a Ventas, si no, a Home (Login) *@
                <a class="navbar-brand" asp-area="" asp-controller="@(isLoggedIn ? (isAdmin ? "Dashboard" : "Venta") : "Home")" asp-action="Index">@appName</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Mostrar enlaces principales solo si el usuario ha iniciado sesión *@
                        @if (isLoggedIn)
                        {
                            // Enlace al Dashboard (solo visible para Admin)
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Venta" asp-action="Index">Ventas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Cliente" asp-action="Index">Clientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Producto" asp-action="Index">Productos</a>
                            </li>
                            // Enlace a Gestión de Usuarios (solo visible para Admin)
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                </li>
                            }
                        }
                        @* Puedes añadir enlaces públicos aquí si los necesitas *@
                        @* <li class="nav-item">
                               <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                           </li> *@
                    </ul>

                    @* --- Sección de Usuario y Login/Logout --- *@
                    <ul class="navbar-nav">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <span class="navbar-text">
                                    @* Podrías añadir un icono: <i class="bi bi-person-circle me-1"></i> *@
                                    Hola, @userName! (@userRole)
                                </span>
                            </li>
                            <li class="nav-item ms-2">
                                <form asp-area="" asp-controller="Home" asp-action="Logout" method="post" id="logoutForm">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Cerrar Sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            @* Mostrar enlaces de Login y Registro si no ha iniciado sesión *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Register">Registrarse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Iniciar Sesión</a>
                            </li>
                        }
                    </ul>
                    @* ---------------------------------- *@
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        @* Añadido margen superior al container principal *@
        <main role="main" class="pb-3">
            @* Mostrar mensajes de TempData (ya estaba) *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3 bg-light">
        @* Estilos footer opcionales *@
        <div class="container text-center">
            &copy; @DateTime.Now.Year - @appName - Todos los derechos reservados.
            @* <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a> *@
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
