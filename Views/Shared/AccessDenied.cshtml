    @inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
    @if (HttpContextAccessor.HttpContext?.Session.GetInt32("UserId").HasValue ?? false)
    {
        <form asp-area="" asp-controller="Home" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-secondary">Cerrar Sesión</button>
        </form>
    }
    *@
</div>
