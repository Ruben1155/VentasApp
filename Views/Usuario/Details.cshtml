@* ================================================== *@
@* VentasApp/Views/Usuario/Details.cshtml             *@
@* ================================================== *@
@model VentasApp.Models.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>

@if (Model != null)
{
    <div>
        <h4>Usuario</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Apellido)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Apellido)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Correo)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Correo)</dd>

            @* <dt class = "col-sm-3">@Html.DisplayNameFor(model => model.Telefono)</dt>
            <dd class = "col-sm-9">@Html.DisplayFor(model => model.Telefono)</dd> *@

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Rol)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Rol)</dd>
        </dl>
    </div>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
    </div>
}
else
{
    <div class="alert alert-warning">No se encontraron detalles para este usuario.</div>
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
}