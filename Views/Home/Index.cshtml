@model VentasApp.Models.LoginViewModel // Asegúrate que el namespace sea correcto

@{
    ViewData["Title"] = "Iniciar Sesión";
    // Puedes quitar el Layout si es una página independiente
    // Layout = null;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h2 class="text-center mb-4">@ViewData["Title"]</h2>
        <hr />

        @* Mostrar mensaje de éxito desde TempData (si viene del registro) *@
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success" role="alert">
                @ViewBag.SuccessMessage
            </div>
        }

        <form asp-action="Login" method="post">
            @* Resumen de errores de validación *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3 form-floating">
                <input asp-for="Correo" class="form-control" placeholder="Correo Electrónico" />
                <label asp-for="Correo">Correo Electrónico</label>
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3 form-floating">
                <input asp-for="Clave" type="password" class="form-control" placeholder="Contraseña" />
                <label asp-for="Clave">Contraseña</label>
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>

            @* Opcional: Checkbox "Recordarme" si tu LoginViewModel lo tiene *@
            @*
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" asp-for="RememberMe" />
                <label class="form-check-label" asp-for="RememberMe">Recordarme</label>
            </div>
            *@

            @* Token Anti-Falsificación *@
            @Html.AntiForgeryToken()

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Ingresar</button>
            </div>

            <div class="mt-3 text-center">
                <p>
                    ¿No tienes cuenta? <a asp-action="Register" asp-controller="Home">Regístrate aquí</a>
                </p>
            </div>
        </form>
    </div>
</div>

@* Importante: Incluir scripts de validación del lado del cliente *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}